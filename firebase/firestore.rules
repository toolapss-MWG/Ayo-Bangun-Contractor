rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && userDoc().role == role;
    }

    function hasAnyRole(roles) {
      return isSignedIn() && (userDoc().role in roles);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || hasAnyRole(['owner', 'admin']));
      allow create: if isSignedIn() && hasAnyRole(['owner', 'admin']);
      allow update: if isSignedIn() && (request.auth.uid == userId || hasAnyRole(['owner', 'admin']));
      allow delete: if isSignedIn() && hasRole('owner');
    }

    match /projects/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && hasAnyRole(['owner', 'admin']);
      allow delete: if isSignedIn() && hasRole('owner');
    }

    match /materials/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && hasAnyRole(['owner', 'admin']);
      allow delete: if isSignedIn() && hasRole('owner');
    }

    match /attendance/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasAnyRole(['owner', 'admin', 'mandor']);
      allow update, delete: if isSignedIn() && hasAnyRole(['owner', 'admin']);
    }

    match /material_usage/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasAnyRole(['owner', 'admin', 'mandor']);
      allow update, delete: if isSignedIn() && hasAnyRole(['owner', 'admin']);
    }

    match /kendala/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasAnyRole(['owner', 'admin', 'mandor']);
      allow update, delete: if isSignedIn() && hasAnyRole(['owner', 'admin']);
    }

    match /progres/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasAnyRole(['owner', 'admin', 'mandor']);
      allow update, delete: if isSignedIn() && hasAnyRole(['owner', 'admin']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId} {
   allow read: if request.auth != null;
   allow write: if request.auth != null && request.auth.uid == userId;
  }
  match /projects/{id} {
   allow read: if request.auth != null;
   allow write: if request.auth != null;
  }
  match /materials/{id} {
   allow read: if request.auth != null;
   allow write: if request.auth != null;
  }
 }
}
